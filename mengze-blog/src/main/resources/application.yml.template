# 配置文件使用说明：
# 1. 复制此文件为 application.yml
# 2. 修改所有标记为"请修改"的配置项
# 3. 不要将 application.yml 提交到Git

# 服务器配置
server:
  port: 1314  # 应用服务端口号

# Spring框架配置
spring:
  # 数据源配置（MySQL）
  datasource:
    # 数据库连接URL
    # characterEncoding=utf8: 字符编码设置为UTF-8
    # serverTimezone=Asia/Shanghai: 时区设置为上海（东八区）
    url: jdbc:mysql://localhost:3306/yun_blog?characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username:  ${SQL_USERNAME:your_sql_username}       # 数据库用户名
    password: ${SQL_PASSWORD:your_sql_password}        # 【请修改】数据库密码
    driver-class-name: com.mysql.cj.jdbc.Driver  # MySQL驱动类

  # Spring Security配置
  security:
    sysUser:
      name: ${SECURITY_USER_NAME:your_security_username}           # 默认用户名
      password: YOUR_SECURITY_PASSWORD      # 【请修改】默认密码

  # Redis配置
  redis:
    host: localhost             # Redis服务器地址
    port: 6379                  # Redis端口号
    database: 0                 # Redis数据库索引（0-15）
    timeout: 3000               # 连接超时时间（毫秒）

  # 文件上传配置
  servlet:
    multipart:
      max-file-size: 2MB        # 单个文件最大大小
      max-request-size: 5MB     # 单次请求最大大小

  # 邮件服务配置（QQ邮箱）
  # 获取授权码步骤：
  # 1. 登录QQ邮箱 https://mail.qq.com
  # 2. 设置 -> 账户 -> POP3/IMAP/SMTP服务
  # 3. 开启"POP3/SMTP服务"
  # 4. 生成授权码（16位字符）
  mail:
    host: smtp.qq.com                       # SMTP服务器地址
    port: 587                               # SMTP端口（587为TLS端口）
    username: ${QQ_EMAIL_USERNAME:your_qq_email_username}             # 【请修改】发件人邮箱地址
    password: ${QQ_EMAIL_KEY:your_qq_email_key}                       # 【请修改】QQ邮箱授权码（不是QQ密码）
    properties:
      mail:
        smtp:
          auth: true            # 启用SMTP认证
          starttls:
            enable: true        # 启用TLS加密
            required: true      # 要求TLS加密
    default-encoding: UTF-8     # 邮件编码格式

# MyBatis Plus配置
mybatis-plus:
  configuration:
    # 开启SQL日志输出到控制台（开发环境使用，生产环境建议关闭）
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
    # 开启驼峰命名转换（Java驼峰 <-> 数据库下划线）
    # 例如：userName <-> user_name
    map-underscore-to-camel-case: true
  global-config:
    db-config:
      # 逻辑删除配置
      logic-delete-field: delFlag    # 逻辑删除字段名
      logic-delete-value: 1          # 逻辑删除值（已删除）
      logic-not-delete-value: 0      # 逻辑未删除值（未删除）
      id-type: auto                  # 主键策略：数据库自增

# 七牛云对象存储配置
# 用于文件上传功能（头像、文章图片等）
# 获取密钥步骤：
# 1. 登录七牛云 https://portal.qiniu.com
# 2. 个人中心 -> 密钥管理
# 3. 复制AccessKey和SecretKey
#
# 推荐使用环境变量方式配置：
# Windows CMD: set OSS_ACCESS_KEY=your_key
# Windows PowerShell: $env:OSS_ACCESS_KEY="your_key"
oss:
  # 七牛云AccessKey（从环境变量读取，未设置时使用默认值）
  accessKey: ${OSS_ACCESS_KEY:your_access_key}
  # 七牛云SecretKey（从环境变量读取，未设置时使用默认值）
  secretKey: ${OSS_SECRET_KEY:your_secret_key}
  # 存储空间名称改成你自己的存储空间名称（Bucket）
  bucket: ${OSS_BUCKET_NAME:your_bucket_name}
  # # OSS访问域名改成你自己的域名或者oss给的试用域名（需要以/结尾）
  domain: ${OSS_VISIT_DOMAIN:your_oss_visit_domain}

# 阿里云号码认证服务配置
# 用于发送短信验证码（登录、注册、忘记密码）
# 获取密钥步骤：
# 1. 登录阿里云 https://www.aliyun.com
# 2. 控制台 -> AccessKey管理
# 3. 创建AccessKey
# 4. 开通号码认证服务 https://dypns.console.aliyun.com
#
# 推荐使用环境变量方式配置：
# Windows CMD: set ALIYUN_ACCESS_KEY_ID=your_key_id
# Windows PowerShell: $env:ALIYUN_ACCESS_KEY_ID="your_key_id"
aliyun:
  sms:
    # 阿里云AccessKeyId（从环境变量读取，未设置时使用默认值）
    access-key-id: ${ALIYUN_ACCESS_KEY_ID:your_access_key_id}
    # 阿里云AccessKeySecret（从环境变量读取，未设置时使用默认值）
    access-key-secret: ${ALIYUN_ACCESS_KEY_SECRET:your_access_key_secret}
    # 短信签名（需要在阿里云控制台申请）
    sign-name: 云梦泽的个人博客验证码
    # 短信模板CODE（100001为通用验证码模板，无需审核）
    template-code: 100001

# 博客前端配置
blog:
  frontend:
    # 前端网站URL（用于邮件通知中的链接）
    url: ${BLOG_FRONTEND_URL:blog_frontend_url}  # 【请修改】改为你的前端网站地址，例如：https://www.yourdomain.com

# 和风天气API配置（JWT认证方式）
weather:
  api:
    key-id: ${WEATHER_KEY_ID:your_key_id}                       # 凭据ID
    project-id: ${WEATHER_PROJECT_ID:your_project_id}           # 项目ID
    host: ${WEATHER_API_HOST:your_api_host}                     # API Host
    private-key: ${WEATHER_PRIVATE_KEY:your_private_key}        # 和风天气私钥（从环境变量读取）
    cache-minutes: 30                                           # 天气数据缓存时间（分钟）

# DeepSeek AI配置
deepseek:
  api-key: ${DEEPSEEK_API_KEY:your_deepseek_api_key} # DeepSeek API Key（从环境变量读取）
  base-url: https://api.deepseek.com # DeepSeek API地址

# 行为验证码配置， 详细请看 cloud.tianai.captcha.autoconfiguration.ImageCaptchaProperties 类
captcha:
  # 如果项目中使用到了redis，滑块验证码会自动把验证码数据存到redis中， 这里配置redis的key的前缀,默认是captcha:slider
  prefix: captcha
  # 验证码过期时间，默认是2分钟,单位毫秒， 可以根据自身业务进行调整
  expire:
    # 默认缓存时间 2分钟
    default: 10000
    # 针对 点选验证码 过期时间设置为 2分钟， 因为点选验证码验证比较慢，把过期时间调整大一些
    WORD_IMAGE_CLICK: 20000
  # 使用加载系统自带的资源， 默认是 false(这里系统的默认资源包含 滑动验证码模板/旋转验证码模板,如果想使用系统的模板，这里设置为true)
  init-default-resource: true
  # 缓存控制， 默认为false不开启
  local-cache-enabled: false
  # 缓存开启后，验证码会提前缓存一些生成好的验证数据， 默认是20
  local-cache-size: 20
  # 缓存开启后，缓存拉取失败后等待时间 默认是 5秒钟
  local-cache-wait-time: 5000
  # 缓存开启后，缓存检查间隔 默认是2秒钟
  local-cache-period: 2000
  # 缓存开启后，忽略的字段，默认是 ""(不忽略任何字段)
  local-cache-ignored-cache-fields: ""
  # 配置字体包，供文字点选验证码使用,可以配置多个，不配置使用默认的字体
  font-path:
    - classpath:font/SimHei.ttf
  secondary:
    # 二次验证， 默认false 不开启
    enabled: false
    # 二次验证过期时间， 默认 2分钟
    expire: 120000
    # 二次验证缓存key前缀，默认是 captcha:secondary
    keyPrefix: "captcha:secondary"


# 配置说明
# 1. 必须修改的配置：
#    - spring.datasource.password（数据库密码）
#    - spring.mail.username（邮箱地址）
#    - spring.mail.password（邮箱授权码）
#    - blog.frontend.url（前端网站地址）
#
# 2. 可选配置（如需使用相关功能）：
#    - oss.accessKey 和 oss.secretKey（文件上传）
#    - aliyun.sms.access-key-id 和 access-key-secret（短信验证码）
